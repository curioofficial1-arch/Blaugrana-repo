rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1 / Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition & Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'anda4p2t0x@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'membershipTier', 'membershipNumber', 'favoritePlayer', 'country'])
        && data.keys().hasOnly(['id', 'displayName', 'penya', 'favoritePlayer', 'membershipTier', 'membershipNumber', 'country', 'bio', 'avatarUrl', 'loyaltyPoints', 'badges', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50
        && (!('penya' in data) || (data.penya is string && data.penya.size() <= 80))
        && data.favoritePlayer is string && data.favoritePlayer.size() <= 50
        && data.membershipTier in ['Soci', 'Culers Premium', 'Fan Culer']
        && data.membershipNumber is string && data.membershipNumber.size() <= 30
        && data.country is string && data.country.size() <= 50
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 280))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 200))
        && (!('loyaltyPoints' in data) || data.loyaltyPoints is number)
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 20));
    }

    // Validation Blueprint for PrivateInfo
    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['email'])
        && data.keys().hasOnly(['email', 'emailNotifications', 'updatedAt'])
        && data.email is string && data.email.size() <= 120
        && (!('emailNotifications' in data) || data.emailNotifications is bool);
    }

    // Public User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().membershipNumber == existing().membershipNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'penya', 'favoritePlayer', 'country', 'bio', 'avatarUrl', 'loyaltyPoints', 'badges', 'membershipTier', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    // Isolated Private PII Subcollection
    match /users/{userId}/private/{docId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId);
      allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidPrivateInfo(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if false;
    }
  }
}
